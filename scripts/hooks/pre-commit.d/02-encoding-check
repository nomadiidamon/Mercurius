#!/bin/sh

set -e
ROOT="$(git rev-parse --show-toplevel)"

echo "Checking UTF-8 encoding under examples, docs, cpp/src, and python/src..."

if python3 -c "import sys" >/dev/null 2>&1; then
    python3 "$ROOT/tools/fix_encoding.py" --check
elif python -c "import sys" >/dev/null 2>&1; then
    python "$ROOT/tools/fix_encoding.py" --check
elif py -3 -c "import sys" >/dev/null 2>&1; then
    py -3 "$ROOT/tools/fix_encoding.py" --check
else
    echo "ERROR: No working Python interpreter found."
    exit 1
fi
